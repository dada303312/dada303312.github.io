---
import { render } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, postHref, readingTime, tagHref, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      related: posts
        .filter((candidate) => candidate.id !== post.id)
        .map((candidate) => ({
          post: candidate,
          score: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length + (candidate.data.category === post.data.category ? 1 : 0),
        }))
        .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
        .slice(0, 2)
        .map(({ post: relatedPost }) => relatedPost),
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}

interface Props {
  post: Post;
  related: Post[];
  newer?: Post;
  older?: Post;
}

const { post, related, newer, older } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} type="article">
  <div class="reading-progress" data-reading-progress></div>
  <article class="article-shell">
    <header class="article-header">
      <div class="article-kicker">{post.data.category}</div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span>·</span>
        <span>{readingTime(post)} 分钟阅读</span>
        {post.data.updatedDate && <><span>·</span><span>更新于 {formatDate(post.data.updatedDate)}</span></>}
      </div>
    </header>

    {post.data.cover && (
      <figure class="article-cover">
        <img src={post.data.cover} alt={`${post.data.title} 封面`} loading="eager" decoding="async" />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      <div class="article-footer-row">
        <div class="tag-list">
          {post.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>#{tag}</a>)}
        </div>
        <a class="back-link" href="/archive/">← 返回全部文章</a>
      </div>
    </footer>
  </article>

  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <div class="section-heading-row">
          <h2 class="section-heading">继续阅读</h2>
          <div class="article-meta">
            {older && <a href={postHref(older)}>上一篇</a>}
            {newer && <a href={postHref(newer)}>下一篇</a>}
          </div>
        </div>
        <div class="post-grid">
          {related.map((relatedPost) => <PostCard post={relatedPost} />)}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    const progress = document.querySelector('[data-reading-progress]');
    const article = document.querySelector('.prose');
    const updateProgress = () => {
      if (!progress || !article) return;
      const start = article.getBoundingClientRect().top + window.scrollY;
      const total = article.scrollHeight - window.innerHeight * 0.35;
      const value = Math.min(1, Math.max(0, (window.scrollY - start + window.innerHeight * 0.2) / total));
      progress.style.transform = `scaleX(${value})`;
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  </script>
</BaseLayout>

